<h2 class="mb-4">

    Edit Pelanggan

</h2>

<form
action="/customers/edit/<%= customer.id %>"
method="POST">

    <div class="mb-3">

        <label class="form-label">

            Nama

        </label>

        <input
        type="text"
        name="name"
        class="form-control"
        value="<%= customer.name %>"
        required>

    </div>

    <div class="mb-3">

        <label class="form-label">

            Nomor HP

        </label>

        <input
        type="text"
        name="phone"
        class="form-control"
        value="<%= customer.phone %>"
        required>

    </div>

    <div class="mb-3">

        <label class="form-label">

            Telegram Username

        </label>

        <input
        type="text"
        name="telegram_username"
        class="form-control"
        value="<%= customer.telegram_username %>">

    </div>

    <div class="mb-3">

        <label class="form-label">

            Telegram Chat ID

        </label>

        <input
        type="text"
        name="telegram_chat_id"
        class="form-control"
        value="<%= customer.telegram_chat_id %>">

    </div>

    <div class="mb-3">

        <label class="form-label">

            Alamat

        </label>

        <textarea
        name="address"
        class="form-control"><%= customer.address %></textarea>

    </div>

    <button
    type="submit"
    class="btn btn-warning">

        Update

    </button>

    <a
    href="/customers"
    class="btn btn-secondary">

        Kembali

    </a>

    <a
    href="/customers/edit/<%= customer.id %>"
    class="btn btn-warning btn-sm">

        Edit

    </a>

</form>