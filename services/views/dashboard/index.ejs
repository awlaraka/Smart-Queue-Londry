<h2 class="mb-4">

    Dashboard

</h2>

<div class="row">

    <div class="col-md-3">

        <div class="card text-bg-primary">

            <div class="card-body">

                <h5>Total Pesanan</h5>

                <h2>

                    <%= totalOrders %>

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-bg-success">

            <div class="card-body">

                <h5>Pesanan Selesai</h5>

                <h2>

                    <%= finishedOrders %>

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-bg-warning">

            <div class="card-body">

                <h5>Sedang Diproses</h5>

                <h2>

                    <%= processingOrders %>

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-bg-danger">

            <div class="card-body">

                <h5>Pendapatan Hari Ini</h5>

                <h2>

                    <%= rupiah(incomeToday) %>

                </h2>

            </div>

        </div>

    </div>

</div>
<hr class="my-5">

<div class="row">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-body">

                <h5 class="mb-3">

                    Grafik Jumlah Pesanan

                </h5>

                <canvas id="orderChart"></canvas>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-body">

                <h5 class="mb-3">

                    Grafik Pendapatan

                </h5>

                <canvas id="incomeChart"></canvas>

            </div>

        </div>

    </div>

</div>

<hr class="my-5">

<div class="card shadow">

    <div class="card-body">

        <h4>

            Statistik Status Laundry

        </h4>

        <canvas id="statusChart"></canvas>

    </div>

</div>
<script>

const orderChart = document.getElementById('orderChart');

new Chart(orderChart, {

    type: 'bar',

    data: {

        labels: [

            'Sen',

            'Sel',

            'Rab',

            'Kam',

            'Jum',

            'Sab',

            'Min'

        ],

        datasets: [

            {

                label: 'Jumlah Pesanan',

                data: <%- JSON.stringify(orderData) %>

            }

        ]

    }

});

</script>
<script>

const incomeChart = document.getElementById('incomeChart');

new Chart(incomeChart, {

    type: 'line',

    data: {

        labels: [

            'Sen',

            'Sel',

            'Rab',

            'Kam',

            'Jum',

            'Sab',

            'Min'

        ],

        datasets: [

            {

                label: 'Pendapatan',

                data: <%- JSON.stringify(incomeData) %>

            }

        ]

    }

});

</script>
<script>

const statusChart = document.getElementById('statusChart');

new Chart(statusChart, {

    type: 'pie',

    data: {

        labels: <%- JSON.stringify(statusLabels) %>,

        datasets: [

            {

                label: 'Jumlah Laundry',

                data: <%- JSON.stringify(statusData) %>,

            }

        ]

    }

});

</script>

        }

    }

);

</script>